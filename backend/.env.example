# ============================================
# QURAN TWIN - ENVIRONMENT TEMPLATE
# ============================================
# Copy this to .env and fill in your values

# Server Configuration
PORT=5000
NODE_ENV=production
LOG_LEVEL=warn

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Redis (optional - for rate limiting)
# REDIS_URL=redis://user:password@host:6379

# Quran Foundation OAuth
QURAN_CLIENT_ID=your_client_id
QURAN_CLIENT_SECRET=your_client_secret
QURAN_REDIRECT_URI=https://your-domain.com/auth/callback

# Quran Foundation APIs (Production endpoints)
OAUTH_BASE_URL=https://oauth2.quran.foundation
API_BASE_URL=https://apis.quran.foundation
QURAN_API_BASE=https://api.quran.com/api/v4
QURAN_NOTES_API=https://apis.quran.foundation/auth/v1/notes

# Frontend URL
FRONTEND_URL=https://your-domain.com

# Groq AI API Key
GROQ_API_KEY=your_groq_api_key